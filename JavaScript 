const data = {
    "Central": {
        "Chibombo": ["Chibombo", "Keembe", "Mungule"],
        "Kabwe": ["Kabwe Central", "Makululu", "Nangoma"],
        "Kapiri Mposhi": ["Kapiri", "Luanshya Road", "Mukonchi"]
    },

    "Copperbelt": {
        "Kitwe": ["Chimwemwe", "Ndeke", "Riverside"],
        "Ndola": ["Kansenshi", "Masala", "Kabushi"],
        "Chingola": ["Nchanga", "Chiwempala", "Kawama"]
    },

    "Lusaka": {
        "Lusaka": ["Kabulonga", "Chilenje", "Matero", "Kanyama"],
        "Chongwe": ["Chongwe", "Kanakantapa", "Chalimbana"],
        "Kafue": ["Kafue", "Shikoswe", "Chawama"]
    },

    "Southern": {
        "Livingstone": ["Maramba", "Dambwa", "Libala"],
        "Choma": ["Choma Central", "Mwapona", "Batoka"],
        "Mazabuka": ["Mazabuka Central", "Munyama", "Magoye"]
    }
};

const provinceSelect = document.getElementById("province");
const districtSelect = document.getElementById("district");
const areaSelect = document.getElementById("area");
const result = document.getElementById("result");

Object.keys(data).forEach(province => {
    const option = document.createElement("option");
    option.value = province;
    option.textContent = province;
    provinceSelect.appendChild(option);
});

provinceSelect.addEventListener("change", function () {
    districtSelect.innerHTML =
        '<option value="">Choose District</option>';

    areaSelect.innerHTML =
        '<option value="">Choose Area</option>';

    const districts = data[this.value];

    if (districts) {
        Object.keys(districts).forEach(district => {
            const option = document.createElement("option");
            option.value = district;
            option.textContent = district;
            districtSelect.appendChild(option);
        });
    }
});

districtSelect.addEventListener("change", function () {
    areaSelect.innerHTML =
        '<option value="">Choose Area</option>';

    const province = provinceSelect.value;
    const areas = data[province][this.value];

    areas.forEach(area => {
        const option = document.createElement("option");
        option.value = area;
        option.textContent = area;
        areaSelect.appendChild(option);
    });
});

function showLocation() {
    const province = provinceSelect.value;
    const district = districtSelect.value;
    const area = areaSelect.value;

    if (!province || !district || !area) {
        result.textContent = "Please select all three options.";
        return;
    }

    result.textContent =
        `Selected: ${area}, ${district}, ${province} Province`;
}